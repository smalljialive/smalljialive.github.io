- loading_img = theme.preloader.avatar ? theme.preloader.avatar : theme.avatar.img
#loading-box
  .loading-bg(role='status' aria-live='polite' aria-label='页面加载中')
    .loading-card
      .loading-avatar-wrap
        .loading-avatar-ring
        img.loading-img(alt="Small Jia" class='nolazyload' src=url_for(loading_img))
        .loading-image-dot
      .loading-brand= config.title || 'Small Jia'
      .loading-message 正在打开这一页…
      .loading-track(aria-hidden='true')
        .loading-progress
script.
  const preloader = {
    endLoading: () => {
      const box = document.getElementById('loading-box');
      if (box) box.classList.add('loaded');
    },
    initLoading: () => {
      const box = document.getElementById('loading-box');
      if (box) box.classList.remove('loaded');
    }
  }

  // The toolbox page contains many external site icons. Waiting for window.load
  // keeps the full-screen loading layer above an already usable document until
  // every slow third-party resource settles. Release it as soon as the DOM is
  // interactive, then let icons and enhancements continue loading in the back.
  const isToolboxPage = () => {
    const path = window.location.pathname.replace(/\/+$/, '') || '/';
    return path === '/link';
  };

  const endToolboxLoadingEarly = () => {
    const finish = () => requestAnimationFrame(() => requestAnimationFrame(() => preloader.endLoading()));
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', finish, { once: true });
    } else {
      finish();
    }
  };

  if (isToolboxPage()) endToolboxLoadingEarly();
  window.addEventListener('load', () => { preloader.endLoading() }, { once: true })
  setTimeout(function(){ preloader.endLoading(); }, isToolboxPage() ? 1500 : 10000)

  if (!{theme.pjax && theme.pjax.enable}) {
    document.addEventListener('pjax:send', () => { preloader.initLoading() })
    document.addEventListener('pjax:complete', () => { preloader.endLoading() })
  }
