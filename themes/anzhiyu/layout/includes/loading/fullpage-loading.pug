- loading_img = theme.preloader.avatar ? theme.preloader.avatar : theme.avatar.img
#loading-box
  .loading-bg(role='status' aria-live='polite' aria-label='页面加载中')
    .loading-card
      .loading-avatar-wrap
        .loading-avatar-ring
        img.loading-img(alt="Small Jia" class='nolazyload' src=url_for(loading_img))
        .loading-image-dot
      .loading-brand= config.title || 'Small Jia'
      .loading-message 空间站正在重新连接
      .loading-track(aria-hidden='true')
        .loading-progress
script.
  const preloader = {
    endLoading: () => {
      const box = document.getElementById('loading-box');
      if (box) box.classList.add('loaded');
    },
    initLoading: () => {
      const box = document.getElementById('loading-box');
      if (box) box.classList.remove('loaded');
    }
  }

  const isLinkPage = () => {
    const path = window.location.pathname.replace(/\/+$/, '') || '/';
    return path === '/link';
  };

  // Link 页不再死等所有外部 favicon 的 window.load，
  // 也不在 DOM 一出来就立即放行。等 DOM 完成后，优先等待浏览器出现空闲时间，
  // 这样既能让主题完成首轮布局/脚本初始化，又不会被慢速第三方图片拖住太久。
  if (isLinkPage()) {
    let finished = false;
    const finish = () => {
      if (finished) return;
      finished = true;
      requestAnimationFrame(() => requestAnimationFrame(() => preloader.endLoading()));
    };

    const waitForIdle = () => {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(finish, { timeout: 2200 });
      } else {
        setTimeout(finish, 900);
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        setTimeout(waitForIdle, 120);
      }, { once: true });
    } else {
      setTimeout(waitForIdle, 120);
    }

    // 如果真实 load 更早完成，立即显示页面；最迟约 4 秒放行。
    window.addEventListener('load', finish, { once: true });
    setTimeout(finish, 4000);
  } else {
    window.addEventListener('load', () => { preloader.endLoading() }, { once: true });
    setTimeout(function(){ preloader.endLoading(); }, 10000);
  }

  if (!{theme.pjax && theme.pjax.enable}) {
    document.addEventListener('pjax:send', () => { preloader.initLoading() })
    document.addEventListener('pjax:complete', () => { preloader.endLoading() })
  }
