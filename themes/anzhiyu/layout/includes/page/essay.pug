if site.data.essay
  each i in site.data.essay
    #essay_page
      .author-content.author-content-item.essayPage.single(style = i.top_background ? `background: url(${i.top_background}) left 28% / cover no-repeat;` : "")
        .card-content
          .author-content-item-tips=i.title
          span.author-content-item-title=i.subTitle
          .content-bottom
            .tips=i.tips
          .banner-button-group
            a.banner-button(href=i.buttonLink)
              i.anzhiyufont.anzhiyu-icon-arrow-circle-right
              span.banner-button-text=i.buttonText

      #essay-memory-tools
        .essay-memory-card.essay-today-card
          .essay-memory-head
            div
              .essay-memory-kicker 时光回声
              .essay-memory-title 那年今日
            .essay-memory-icon 🕰️
          #essay-today-list.essay-today-list
            .essay-memory-empty 正在翻找往年的今天…
        .essay-memory-card.essay-archive-card
          .essay-memory-head
            div
              .essay-memory-kicker 时间胶囊
              .essay-memory-title 年度档案
            .essay-memory-icon 🗂️
          #essay-year-filters.essay-year-filters
          #essay-archive-summary.essay-archive-summary

      #bber
        section.timeline.page-1
          ul#waterfall.list
            each item, index in i.essay_list
              li.bber-item(data-essay-date=item.date, data-essay-content=item.content, data-essay-from=(item.from || ''))
                .bber-content
                  p.datacont= item.content
                    if item.image
                      .bber-container-img
                        each iten, indey in item.image
                          a.bber-content-img(href=url_for(item.image[indey]), target="_blank", data-fancybox="gallery", data-caption="")
                            img(src=url_for(item.image[indey]))
                        .bber-content-noimg
                        .bber-content-noimg
                        .bber-content-noimg
                    if item.video
                      .bber-container-img
                        each iten, indey in item.video  
                          if (item.video[indey].includes('player.bilibili.com'))
                            div(style="position: relative; padding: 30% 45%;margin-top: 10px;margin-bottom: 10px;")
                              iframe(style="position: absolute; width: 100%; height: 100%; left: 0; top: 0;margin: 0;border-radius: 12px;border: var(--style-border);" src=url_for(item.video[indey]) scrolling="no" border="0" frameborder="no" framespacing="0" allowfullscreen="true")
                          else
                            a.bber-content-video(href=url_for(item.video[indey]) data-fancybox="gallery", data-caption="")
                              video(src=url_for(item.video[indey]))
                        .bber-content-noimg
                        .bber-content-noimg
                        .bber-content-noimg
                    if item.aplayer
                      .bber-music
                        meting-js(id=item.aplayer.id, server=item.aplayer.server, type="song", mutex="true",preload="none", theme="var(--anzhiyu-main)", data-lrctype="0", order="list")
                hr
                .bber-bottom
                  .bber-info
                    .bber-info-time
                      i.anzhiyufont.anzhiyu-icon-clock
                      time.datatime(datetime=date_xml(item.date))= date(item.date, config.date_format)
                    if item.link 
                      a.bber-content-link(title="跳转到短文指引的链接", href=url_for(item.link), rel="external nofollow")
                        i.anzhiyufont.anzhiyu-icon-link
                        | 链接
                    if item.from
                      .bber-info-from
                        i.anzhiyufont.anzhiyu-icon-fw-fire
                        span=item.from
                    if item.address
                      .bber-info-from
                        i.anzhiyufont.anzhiyu-icon-location-dot
                        span=item.address
                  if page.comments !== false && theme.comments && theme.comments.use
                    .bber-reply(onclick="rm.rightMenuCommentText(" + `'${item.content}'` + ")")
                      i.anzhiyufont.anzhiyu-icon-message

      style.
        #essay-memory-tools {
          display: grid;
          grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
          gap: 1rem;
          margin-top: 1rem;
        }
        .essay-memory-card {
          min-width: 0;
          padding: 1.1rem 1.2rem;
          border: var(--style-border-always);
          border-radius: 18px;
          background: var(--anzhiyu-card-bg);
          box-shadow: var(--anzhiyu-shadow-border);
        }
        .essay-memory-head {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 1rem;
          margin-bottom: .9rem;
        }
        .essay-memory-kicker {
          color: var(--anzhiyu-secondtext);
          font-size: 12px;
          line-height: 1.2;
          margin-bottom: .25rem;
        }
        .essay-memory-title {
          color: var(--anzhiyu-fontcolor);
          font-size: 22px;
          font-weight: 800;
          line-height: 1.2;
        }
        .essay-memory-icon {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 42px;
          height: 42px;
          border-radius: 14px;
          background: var(--anzhiyu-secondbg);
          font-size: 21px;
          flex: 0 0 auto;
        }
        .essay-today-list {
          display: flex;
          flex-direction: column;
          gap: .65rem;
        }
        .essay-today-item {
          padding: .75rem .85rem;
          border-radius: 12px;
          background: var(--anzhiyu-secondbg);
        }
        .essay-today-meta {
          color: var(--anzhiyu-secondtext);
          font-size: 12px;
          margin-bottom: .3rem;
        }
        .essay-today-content {
          color: var(--anzhiyu-fontcolor);
          font-size: 14px;
          font-weight: 700;
          line-height: 1.55;
          white-space: pre-line;
        }
        .essay-memory-empty,
        .essay-archive-summary {
          color: var(--anzhiyu-secondtext);
          font-size: 13px;
          line-height: 1.6;
        }
        .essay-year-filters {
          display: flex;
          flex-wrap: wrap;
          gap: .55rem;
          margin-bottom: .75rem;
        }
        .essay-year-filter {
          appearance: none;
          border: var(--style-border-always);
          border-radius: 999px;
          background: var(--anzhiyu-secondbg);
          color: var(--anzhiyu-fontcolor);
          padding: .42rem .75rem;
          font-size: 13px;
          font-weight: 700;
          cursor: pointer;
          transition: .2s ease;
        }
        .essay-year-filter:hover,
        .essay-year-filter.active {
          border-color: var(--anzhiyu-main);
          background: var(--anzhiyu-main);
          color: var(--anzhiyu-white);
          transform: translateY(-1px);
        }
        #bber .bber-item.essay-archive-hidden {
          display: none !important;
        }
        #bber #waterfall.essay-filtered-layout {
          display: grid !important;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          align-items: start;
          gap: 1rem;
          height: auto !important;
          opacity: 1 !important;
        }
        #bber #waterfall.essay-filtered-layout .bber-item:not(.essay-archive-hidden) {
          position: relative !important;
          inset: auto !important;
          top: auto !important;
          right: auto !important;
          bottom: auto !important;
          left: auto !important;
          transform: none !important;
          width: 100% !important;
          margin: 0 !important;
          display: flex !important;
        }
        @media screen and (max-width: 1200px) {
          #bber #waterfall.essay-filtered-layout {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }
        }
        @media screen and (max-width: 768px) {
          #essay-memory-tools {
            grid-template-columns: 1fr;
          }
          .essay-memory-card {
            padding: 1rem;
          }
          .essay-memory-title {
            font-size: 20px;
          }
          #bber #waterfall.essay-filtered-layout {
            grid-template-columns: 1fr;
          }
        }

      script.
        window.initEssayMemories = function () {
          const root = document.getElementById("essay_page");
          if (!root || root.dataset.memoryReady === "1") return;
          root.dataset.memoryReady = "1";

          const waterfallEl = root.querySelector("#waterfall");
          const items = Array.from(root.querySelectorAll("#waterfall .bber-item[data-essay-date]"));
          const todayList = root.querySelector("#essay-today-list");
          const filters = root.querySelector("#essay-year-filters");
          const summary = root.querySelector("#essay-archive-summary");
          if (!waterfallEl || !items.length || !todayList || !filters || !summary) return;

          const records = items.map(item => {
            const dateText = item.dataset.essayDate || "";
            const parsed = new Date(dateText);
            return {
              item,
              date: parsed,
              year: Number.isNaN(parsed.getTime()) ? 0 : parsed.getFullYear(),
              month: Number.isNaN(parsed.getTime()) ? 0 : parsed.getMonth() + 1,
              day: Number.isNaN(parsed.getTime()) ? 0 : parsed.getDate(),
              content: item.dataset.essayContent || "",
              from: item.dataset.essayFrom || ""
            };
          }).filter(record => record.year);

          let layoutVersion = 0;
          const resetWaterfallInlineStyles = () => {
            waterfallEl.style.removeProperty("height");
            records.forEach(record => {
              const item = record.item;
              item.style.removeProperty("position");
              item.style.removeProperty("top");
              item.style.removeProperty("right");
              item.style.removeProperty("bottom");
              item.style.removeProperty("left");
              item.style.removeProperty("transform");
            });
          };

          const refreshEssayWaterfall = (filtered = false) => {
            const version = ++layoutVersion;
            if (filtered) {
              waterfallEl.classList.add("essay-filtered-layout", "show");
              resetWaterfallInlineStyles();
              return;
            }

            waterfallEl.classList.remove("essay-filtered-layout", "show");
            resetWaterfallInlineStyles();

            const relayout = () => {
              if (version !== layoutVersion || waterfallEl.classList.contains("essay-filtered-layout")) return;
              if (typeof waterfall === "function") {
                waterfall("#waterfall");
                waterfallEl.classList.add("show");
              } else if (typeof anzhiyu !== "undefined" && typeof anzhiyu.reflashEssayWaterFall === "function") {
                anzhiyu.reflashEssayWaterFall();
              } else {
                waterfallEl.classList.add("show");
              }
            };

            requestAnimationFrame(() => requestAnimationFrame(relayout));
            setTimeout(relayout, 120);
            setTimeout(relayout, 420);
          };

          const now = new Date();
          const todayRecords = records
            .filter(record => record.month === now.getMonth() + 1 && record.day === now.getDate() && record.year < now.getFullYear())
            .sort((a, b) => b.year - a.year);

          todayList.innerHTML = "";
          if (!todayRecords.length) {
            const empty = document.createElement("div");
            empty.className = "essay-memory-empty";
            empty.textContent = "往年的今天还没有留下碎碎念。等时间走远一点，再回来看看。";
            todayList.appendChild(empty);
          } else {
            todayRecords.forEach(record => {
              const memory = document.createElement("div");
              memory.className = "essay-today-item";

              const meta = document.createElement("div");
              meta.className = "essay-today-meta";
              const yearsAgo = now.getFullYear() - record.year;
              meta.textContent = `${record.year} 年 · ${yearsAgo} 年前${record.from ? ` · ${record.from}` : ""}`;

              const content = document.createElement("div");
              content.className = "essay-today-content";
              content.textContent = record.content;

              memory.appendChild(meta);
              memory.appendChild(content);
              todayList.appendChild(memory);
            });
          }

          const yearCounts = records.reduce((result, record) => {
            result[record.year] = (result[record.year] || 0) + 1;
            return result;
          }, {});
          const years = Object.keys(yearCounts).map(Number).sort((a, b) => b - a);

          filters.innerHTML = "";
          const createFilter = (label, year, active) => {
            const button = document.createElement("button");
            button.type = "button";
            button.className = `essay-year-filter${active ? " active" : ""}`;
            button.dataset.year = year;
            button.textContent = label;
            filters.appendChild(button);
            return button;
          };

          createFilter(`全部 ${records.length}`, "all", true);
          years.forEach(year => createFilter(`${year} · ${yearCounts[year]}`, String(year), false));
          summary.textContent = `共记录 ${records.length} 条碎碎念，时间跨度 ${years[years.length - 1]} — ${years[0]}。`;

          filters.addEventListener("click", event => {
            const button = event.target.closest(".essay-year-filter");
            if (!button) return;
            const selectedYear = button.dataset.year;
            const filtered = selectedYear !== "all";

            filters.querySelectorAll(".essay-year-filter").forEach(item => item.classList.toggle("active", item === button));
            records.forEach(record => {
              const visible = !filtered || String(record.year) === selectedYear;
              record.item.classList.toggle("essay-archive-hidden", !visible);
            });

            refreshEssayWaterfall(filtered);

            if (!filtered) {
              summary.textContent = `共记录 ${records.length} 条碎碎念，时间跨度 ${years[years.length - 1]} — ${years[0]}。`;
            } else {
              summary.textContent = `${selectedYear} 年共留下 ${yearCounts[selectedYear]} 条碎碎念。`;
            }
          });
        };

        window.initEssayMemories();