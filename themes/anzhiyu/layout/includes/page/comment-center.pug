- const sjCommentSourceMap = {}
- site.posts.each(function (post) {
-   const postUrl = url_for(post.path)
-   sjCommentSourceMap[postUrl] = post.title
- })
- sjCommentSourceMap[url_for('/essay/')] = '碎碎念'
- const sjCommentSourceJson = JSON.stringify(sjCommentSourceMap).replace(/</g, '\\u003c')

.comment-center-page.comment-center-admin-page
  .comment-center-hero
    .comment-center-hero-icon
      i.anzhiyufont.anzhiyu-icon-comments
    .comment-center-hero-copy
      h1 评论管理中心
      p 登录后集中查看、隐藏或删除全站留言，并快速定位留言来源页面。
    .comment-center-hero-badge 管理员专用

  .comment-center-notice.comment-center-security
    i.anzhiyufont.anzhiyu-icon-circle-info
    span 评论内容和管理操作只有通过 Twikoo 管理员认证后才会显示。管理员密码不会写入网站源码或 GitHub。

  .comment-center-admin-card
    .comment-center-admin-card-head
      .comment-center-admin-card-copy
        strong Twikoo 评论管理
        span 可查看原文、标记垃圾、置顶和删除评论。
      button#commentCenterOpenAdmin.comment-center-open-admin(type='button') 打开管理后台
    #commentCenterAdminStatus.comment-center-admin-status 正在加载安全管理后台…
    #commentCenterAdminHost.comment-center-admin-host

script.
  (() => {
    const envId = 'https://smalljia-twikoo.vercel.app'
    const scriptUrl = 'https://cdn.jsdelivr.net/npm/twikoo@1.7.22/dist/twikoo.all.min.js'
    const sourceMapRaw = !{sjCommentSourceJson}
    const statusEl = document.getElementById('commentCenterAdminStatus')
    const openBtn = document.getElementById('commentCenterOpenAdmin')
    const sourceMap = new Map()

    function getTwikooRoot() {
      return document.querySelector('.comment-center-admin-card #twikoo')
    }

    function normalizePath(value) {
      try {
        const url = new URL(value || '/', location.origin)
        let path = url.pathname || '/'
        path = path.replace(/\/index\.html$/i, '/')
        if (!path.startsWith('/')) path = '/' + path
        if (path !== '/' && !/\.[a-z0-9]+$/i.test(path) && !path.endsWith('/')) path += '/'
        return path.replace(/\/+/g, '/')
      } catch (error) {
        return '/'
      }
    }

    Object.entries(sourceMapRaw).forEach(([key, title]) => {
      sourceMap.set(normalizePath(key), String(title || ''))
    })
    sourceMap.set('/essay/', sourceMap.get('/essay/') || '碎碎念')

    function fallbackTitle(path) {
      if (path === '/') return '首页'
      const last = path.split('/').filter(Boolean).pop() || path
      try {
        return decodeURIComponent(last).replace(/[-_]+/g, ' ')
      } catch (error) {
        return last.replace(/[-_]+/g, ' ')
      }
    }

    function getSourceTitle(url) {
      const path = normalizePath(url)
      return sourceMap.get(path) || fallbackTitle(path)
    }

    function loadTwikoo() {
      if (window.twikoo && typeof window.twikoo.init === 'function') return Promise.resolve()
      return new Promise((resolve, reject) => {
        const existing = document.querySelector('script[data-smalljia-comment-admin]')
        if (existing) {
          existing.addEventListener('load', resolve, { once: true })
          existing.addEventListener('error', reject, { once: true })
          return
        }
        const script = document.createElement('script')
        script.src = scriptUrl
        script.async = true
        script.dataset.smalljiaCommentAdmin = '1'
        script.onload = resolve
        script.onerror = reject
        document.head.appendChild(script)
      })
    }

    function openAdmin() {
      const root = getTwikooRoot()
      if (!root) return false

      const vm = root.__vue__
      if (vm && vm.$data && Object.prototype.hasOwnProperty.call(vm.$data, 'showAdmin')) {
        vm.showAdmin = true
        return true
      }

      const icons = root.querySelectorAll('.tk-comments-actions .tk-icon.__comments')
      if (icons.length >= 3) {
        icons[icons.length - 1].click()
        return true
      }
      return false
    }

    function openAdminWithRetry() {
      let tries = 0
      const timer = setInterval(() => {
        tries += 1
        const root = getTwikooRoot()
        if (openAdmin()) {
          clearInterval(timer)
          statusEl.textContent = '管理员入口已打开。请输入 Twikoo 管理员密码登录。'
          return
        }
        if (tries >= 50) {
          clearInterval(timer)
          const gear = root && root.querySelector('.tk-comments-actions .tk-icon.__comments:last-child')
          statusEl.textContent = gear
            ? '请点击评论框右下角的小齿轮进入管理员登录。'
            : '管理员入口暂未就绪，请刷新页面后重试。'
        }
      }, 200)
    }

    function decorateSources() {
      const root = getTwikooRoot()
      const admin = root && root.querySelector('.tk-admin-comment')
      if (!admin) return
      const vm = admin.__vue__
      if (!vm || !Array.isArray(vm.comments)) return
      const items = admin.querySelectorAll('.tk-admin-comment-item')
      items.forEach((item, index) => {
        if (item.querySelector('.sj-admin-source')) return
        const comment = vm.comments[index]
        if (!comment || !comment.url) return
        const path = normalizePath(comment.url)
        const source = document.createElement('div')
        source.className = 'sj-admin-source'
        const label = document.createElement('span')
        label.textContent = '来源'
        const title = document.createElement('strong')
        title.textContent = getSourceTitle(comment.url)
        const code = document.createElement('code')
        code.textContent = path
        source.append(label, title, code)
        const meta = item.querySelector('.tk-admin-comment-meta')
        if (meta) meta.insertAdjacentElement('afterend', source)
        else item.prepend(source)
      })
    }

    async function initAdmin() {
      try {
        await loadTwikoo()
        await window.twikoo.init({
          envId,
          el: '#commentCenterAdminHost',
          path: '/comment-center/'
        })
        statusEl.textContent = '管理后台已加载。未登录时请先输入管理员密码。'
        openAdminWithRetry()

        const root = getTwikooRoot()
        if (root) {
          const observer = new MutationObserver(decorateSources)
          observer.observe(root, { childList: true, subtree: true })
        }
        setInterval(decorateSources, 1000)
      } catch (error) {
        console.error('评论管理后台加载失败', error)
        statusEl.textContent = '管理后台加载失败，请刷新页面重试。'
        statusEl.classList.add('is-error')
      }
    }

    openBtn.addEventListener('click', openAdminWithRetry)
    initAdmin()
  })()
