script.
  (() => {
    const envId = 'https://smalljia-twikoo.vercel.app'
    const scriptUrl = 'https://cdn.jsdelivr.net/npm/twikoo@1.7.22/dist/twikoo.all.min.js'
    const sourceMapRaw = !{sjCommentSourceJson}
    const sourceMap = new Map()
    const state = { comments: [], query: '' }

    const $ = (selector) => document.querySelector(selector)
    const listEl = $('#commentCenterList')
    const loadingEl = $('#commentCenterLoading')
    const emptyEl = $('#commentCenterEmpty')
    const searchEl = $('#commentCenterSearch')
    const refreshEl = $('#commentCenterRefresh')
    const countEl = $('#commentCenterCount')
    const pagesEl = $('#commentCenterPages')
    const latestEl = $('#commentCenterLatest')

    function normalizePath(value) {
      try {
        const url = new URL(value || '/', location.origin)
        let path = url.pathname || '/'
        path = path.replace(/\/index\.html$/i, '/')
        if (!path.startsWith('/')) path = '/' + path
        if (path !== '/' && !/\.[a-z0-9]+$/i.test(path) && !path.endsWith('/')) path += '/'
        return path.replace(/\/+/g, '/')
      } catch (error) {
        return '/'
      }
    }

    Object.entries(sourceMapRaw).forEach(([key, title]) => {
      const normalized = normalizePath(key)
      sourceMap.set(normalized, String(title || ''))
    })
    sourceMap.set('/essay/', sourceMap.get('/essay/') || '碎碎念')

    function fallbackTitle(path) {
      if (path === '/') return '首页'
      const last = path.split('/').filter(Boolean).pop() || path
      try {
        return decodeURIComponent(last).replace(/[-_]+/g, ' ')
      } catch (error) {
        return last.replace(/[-_]+/g, ' ')
      }
    }

    function getSourceTitle(url) {
      const path = normalizePath(url)
      return sourceMap.get(path) || fallbackTitle(path)
    }

    function formatTime(timestamp) {
      const value = Number(timestamp)
      if (!value) return '未知时间'
      try {
        return new Intl.DateTimeFormat('zh-CN', {
          year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit'
        }).format(new Date(value))
      } catch (error) {
        return new Date(value).toLocaleString()
      }
    }

    function createElement(tag, className, text) {
      const el = document.createElement(tag)
      if (className) el.className = className
      if (typeof text !== 'undefined') el.textContent = text
      return el
    }

    function renderStats(items) {
      countEl.textContent = String(items.length)
      pagesEl.textContent = String(new Set(items.map(item => normalizePath(item.url))).size)
      latestEl.textContent = items.length ? (items[0].relativeTime || formatTime(items[0].created)) : '--'
    }

    function makeCard(item) {
      const path = normalizePath(item.url)
      const title = getSourceTitle(item.url)
      const card = createElement('article', 'comment-center-card')

      const avatar = createElement('div', 'comment-center-avatar')
      const img = document.createElement('img')
      img.loading = 'lazy'
      img.referrerPolicy = 'no-referrer'
      img.alt = (item.nick || '访客') + ' 的头像'
      img.src = item.avatar || 'https://cravatar.cn/avatar/' + (item.mailMd5 || '') + '?d=mp&s=96'
      img.onerror = () => { img.src = '/img/favicon.ico' }
      avatar.appendChild(img)

      const body = createElement('div', 'comment-center-card-body')
      const meta = createElement('div', 'comment-center-meta')
      const author = createElement('strong', 'comment-center-author', item.nick || '匿名访客')
      const time = createElement('span', 'comment-center-time', item.relativeTime || formatTime(item.created))
      meta.append(author, time)

      const content = createElement('p', 'comment-center-content', (item.commentText || '').trim() || '（无文本内容）')

      const source = createElement('div', 'comment-center-source')
      const sourceLabel = createElement('span', 'comment-center-source-label', '来源')
      const sourceTitle = createElement('strong', 'comment-center-source-title', title)
      const sourcePath = createElement('code', 'comment-center-source-path', path)
      source.append(sourceLabel, sourceTitle, sourcePath)

      const actions = createElement('div', 'comment-center-card-actions')
      const open = createElement('a', 'comment-center-open')
      open.href = path + '#post-comment'
      open.textContent = '查看原文并回复'
      open.target = '_self'
      const copy = createElement('button', 'comment-center-copy', '复制链接')
      copy.type = 'button'
      copy.addEventListener('click', async () => {
        const absolute = new URL(path + '#post-comment', location.origin).href
        try {
          await navigator.clipboard.writeText(absolute)
          copy.textContent = '已复制'
          setTimeout(() => { copy.textContent = '复制链接' }, 1400)
        } catch (error) {
          window.prompt('复制这个链接：', absolute)
        }
      })
      actions.append(open, copy)

      body.append(meta, content, source, actions)
      card.append(avatar, body)
      return card
    }

    function render() {
      const keyword = state.query.trim().toLowerCase()
      const filtered = state.comments.filter(item => {
        if (!keyword) return true
        const haystack = [item.nick, item.commentText, getSourceTitle(item.url), normalizePath(item.url)]
          .filter(Boolean).join(' ').toLowerCase()
        return haystack.includes(keyword)
      })

      listEl.replaceChildren()
      filtered.forEach(item => listEl.appendChild(makeCard(item)))
      listEl.style.display = filtered.length ? '' : 'none'
      emptyEl.style.display = filtered.length ? 'none' : ''
      renderStats(state.comments)
    }

    function loadTwikooScript() {
      if (window.twikoo && typeof window.twikoo.getRecentComments === 'function') return Promise.resolve()
      return new Promise((resolve, reject) => {
        const existing = document.querySelector('script[data-smalljia-comment-center]')
        if (existing) {
          existing.addEventListener('load', resolve, { once: true })
          existing.addEventListener('error', reject, { once: true })
          return
        }
        const script = document.createElement('script')
        script.src = scriptUrl
        script.async = true
        script.dataset.smalljiaCommentCenter = '1'
        script.onload = resolve
        script.onerror = reject
        document.head.appendChild(script)
      })
    }

    async function loadComments() {
      refreshEl.disabled = true
      loadingEl.style.display = ''
      listEl.style.display = 'none'
      emptyEl.style.display = 'none'
      try {
        await loadTwikooScript()
        const comments = await window.twikoo.getRecentComments({
          envId,
          pageSize: 100,
          includeReply: true
        })
        state.comments = Array.isArray(comments) ? comments : []
        render()
      } catch (error) {
        console.error('评论中心加载失败', error)
        listEl.replaceChildren()
        const errorCard = createElement('div', 'comment-center-error')
        errorCard.append(
          createElement('strong', '', '评论中心暂时加载失败'),
          createElement('span', '', '请稍后刷新页面重试。')
        )
        listEl.appendChild(errorCard)
        listEl.style.display = ''
      } finally {
        loadingEl.style.display = 'none'
        refreshEl.disabled = false
      }
    }

    searchEl.addEventListener('input', () => {
      state.query = searchEl.value || ''
      render()
    })
    refreshEl.addEventListener('click', loadComments)

    loadComments()
  })()
