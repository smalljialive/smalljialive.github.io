#article-container
  - const toolboxGroups = (site.data.link || []).filter(group => group && group.class_name && group.link_list && group.link_list.length)
  - const toolboxTotal = toolboxGroups.reduce((sum, group) => sum + group.link_list.length, 0)
  - const categoryIcons = { '优质导航': '🧭', '优质博主': '✦', 'AI工具': 'AI', '强大插件': '⌘', '小工具站': '⚙', '运营专属': '↗', '视频工具': '▶', '资源大全': '◇', '新奇网站': '✧', '知识学堂': '◎', '游戏大全': '◈', '影视仓库': '▣' }

  .sj-toolbox-app(data-total=toolboxTotal)
    section.sj-toolbox-hero
      .sj-toolbox-hero-copy
        span.sj-toolbox-eyebrow SMALLJIA TOOLBOX
        h1 百宝箱
        p 把真正好用的网站和工具，整理成随手就能找到的入口。
        .sj-toolbox-stats= toolboxTotal + ' 个网站 · ' + toolboxGroups.length + ' 个分类'
      .sj-toolbox-search-wrap
        span.sj-toolbox-search-icon(aria-hidden='true') ⌕
        input.sj-toolbox-search(type='search' autocomplete='off' placeholder='搜索网站、用途或关键词…' aria-label='搜索百宝箱')
        kbd /
        button.sj-toolbox-search-clear(type='button' aria-label='清空搜索') ×

    section.sj-toolbox-filter-wrap
      .sj-toolbox-chips
        button.sj-toolbox-chip.active(type='button' data-category-filter='__all__' aria-pressed='true')
          span.sj-toolbox-chip-icon ⌘
          span 全部
          em= toolboxTotal
        button.sj-toolbox-chip(type='button' data-category-filter='__favorites__' aria-pressed='false')
          span.sj-toolbox-chip-icon ★
          span 常用
          em(data-favorite-count) 0
        each group in toolboxGroups
          button.sj-toolbox-chip(type='button' data-category-filter=group.class_name aria-pressed='false')
            span.sj-toolbox-chip-icon= categoryIcons[group.class_name] || '✦'
            span= group.class_name
            em= group.link_list.length
      .sj-toolbox-result-note= '按分类浏览，共 ' + toolboxTotal + ' 个网站'

    section.sj-toolbox-smart
      .sj-toolbox-smart-panel(data-panel='favorites')
        .sj-toolbox-smart-head
          div
            span.sj-toolbox-smart-kicker QUICK ACCESS
            h2 ★ 我的常用
          span.sj-toolbox-smart-count
        .sj-toolbox-mini-grid
          .sj-toolbox-smart-empty 点击网站卡片右上角的 ☆，把常用入口放到这里。
      .sj-toolbox-smart-panel(data-panel='recent')
        .sj-toolbox-smart-head
          div
            span.sj-toolbox-smart-kicker RECENT
            h2 最近使用
          button.sj-toolbox-clear-recent(type='button') 清空
        .sj-toolbox-mini-grid
          .sj-toolbox-smart-empty 你打开过的网站会自动出现在这里。

    .sj-toolbox-sections
      each group, groupIndex in toolboxGroups
        section.sj-toolbox-section(data-category=group.class_name data-section-index=groupIndex data-expanded='0')
          .sj-toolbox-section-head
            div
              h2= group.class_name
              p= group.class_desc || '收藏的网站与工具'
            span.sj-toolbox-section-count= group.link_list.length + ' 个'
          .sj-toolbox-grid
            each item, itemIndex in group.link_list
              - const itemName = String(item.name || item.link || '网站')
              - const itemDesc = String(item.descr || '打开网站')
              - const itemLink = url_for(item.link || '#')
              - const rawAvatar = String(item.avatar || '')
              - const bangIndex = rawAvatar.indexOf('!')
              - const cleanAvatar = bangIndex === -1 ? rawAvatar : rawAvatar.substring(0, bangIndex)
              - const itemAvatar = cleanAvatar ? url_for(cleanAvatar + (group.hundredSuffix || '')) : ''
              - const itemTag = String(item.tag || group.class_name)
              - const searchText = [itemName, itemDesc, group.class_name, itemLink, itemTag].join(' ').toLowerCase()
              article.sj-toolbox-card(data-url=itemLink data-href=itemLink data-name=itemName data-desc=itemDesc data-avatar=itemAvatar data-tag=itemTag data-category=group.class_name data-search=searchText data-order=itemIndex)
                a.sj-toolbox-card-link.no-text-decoration(href=itemLink title=itemName target='_blank' rel='noopener noreferrer nofollow')
                  span.sj-toolbox-card-icon(class=itemAvatar ? 'has-image' : '')
                    span.sj-toolbox-card-fallback= itemName.slice(0, 1).toUpperCase()
                    if itemAvatar
                      img(src=itemAvatar alt='' loading='lazy' decoding='async' fetchpriority='low' referrerpolicy='no-referrer' width='54' height='54' onerror='this.remove()')
                  span.sj-toolbox-card-body
                    span.sj-toolbox-card-title-row
                      strong.sj-toolbox-card-title= itemName
                      span.sj-toolbox-card-arrow ↗
                    span.sj-toolbox-card-desc= itemDesc
                    span.sj-toolbox-card-meta= itemTag
                button.sj-toolbox-favorite(type='button' data-favorite-url=itemLink aria-label='收藏 ' + itemName aria-pressed='false' title='收藏到我的常用') ☆
          if group.link_list.length > 10
            button.sj-toolbox-more(type='button')= '显示更多（' + (group.link_list.length - 10) + '）'

    .sj-toolbox-empty
      strong 没有找到匹配的网站
      span 换一个关键词，或者切回“全部”试试。

  != page.content
