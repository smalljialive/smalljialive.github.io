#article-container
  //- Toolbox-only source. Keep this page lightweight and do not render the
  //- legacy friend-link banner/random blocks, because those blocks create many
  //- remote image requests before Toolbox mounts.
  .flink.sj-toolbox-data-source(style='display:none')
    if site.data.link
      each i in site.data.link
        if i.class_name
          h2!= i.class_name + "(" + i.link_list.length + ")"
        if i.class_desc
          .flink-desc!=i.class_desc
        if i.link_list
          .anzhiyu-flink-list
            each item in i.link_list
              - let tag = item.tag || ""
              .flink-list-item
                if tag
                  span.site-card-tag= tag
                a.cf-friends-link(href=url_for(item.link) cf-href=url_for(item.link) title=item.name target="_blank")
                  //- Intentionally omit remote avatar URLs for the safe path.
                  //- Toolbox will use the built-in letter fallback and avoid
                  //- third-party favicon requests during initial page load.
                  img.cf-friends-avatar.no-lightbox(alt="")
                  .flink-item-info
                    .flink-item-name.cf-friends-name= item.name
                    .flink-item-desc(title=item.descr)= item.descr
  != page.content
