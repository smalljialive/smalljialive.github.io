if hexo-config('preloader')
  .loading-bg
    display: flex
    align-items: center
    justify-content: center
    width: 100%
    height: 100%
    position: fixed
    inset: 0
    background:
      radial-gradient(circle at 22% 34%, rgba(70, 182, 255, .11) 0, rgba(70, 182, 255, .035) 20%, transparent 46%),
      radial-gradient(circle at 78% 60%, rgba(124, 108, 255, .10) 0, rgba(124, 108, 255, .03) 22%, transparent 48%),
      var(--anzhiyu-card-bg)
    z-index: 1001
    opacity: 1
    overflow: hidden
    transition: opacity .38s ease, visibility .38s ease
    animation: showLoading .28s ease backwards
    &::-webkit-scrollbar
      display: none
    &:before
      content: ''
      position: absolute
      inset: 0
      pointer-events: none
      opacity: .34
      background-image:
        radial-gradient(circle, rgba(66, 90, 239, .24) 0 1px, transparent 1.5px),
        radial-gradient(circle, rgba(70, 182, 255, .2) 0 1px, transparent 1.5px)
      background-size: 68px 68px, 94px 94px
      background-position: 10px 18px, 42px 56px

  #loading-box
    user-select: none

    .loading-card
      position: relative
      display: flex
      flex-direction: column
      align-items: center
      justify-content: center
      width: 470px
      max-width: 90vw
      padding: 31px 34px 25px
      border-radius: 28px
      background: rgba(255, 255, 255, .74)
      border: 1px solid rgba(120, 130, 160, .13)
      box-shadow: 0 20px 62px rgba(50, 60, 100, .11)
      backdrop-filter: blur(19px)
      -webkit-backdrop-filter: blur(19px)
      animation: loadingCardIn .42s cubic-bezier(.2,.8,.2,1) backwards

    .loading-orbit-scene
      width: 100%
      height: 112px
      display: flex
      align-items: center
      justify-content: center
      position: relative
      margin-bottom: 12px

    .loading-celestial
      position: relative
      flex: 0 0 auto
      display: flex
      align-items: center
      justify-content: center
      z-index: 3

    .loading-earth
      width: 92px
      height: 92px
      animation: loadingEarthFloat 3.2s ease-in-out infinite

    .loading-earth-glow
      position: absolute
      inset: 9px
      border-radius: 50%
      background: rgba(70, 182, 255, .16)
      filter: blur(14px)
      animation: loadingGlowPulse 2.2s ease-in-out infinite

    .loading-earth-icon
      width: 82px
      height: 82px
      overflow: visible
      filter: drop-shadow(0 10px 18px rgba(50, 110, 210, .17))
      circle
        fill: #4aa8ff
        stroke: #2979e9
        stroke-width: 4
      path:not(.loading-earth-line)
        fill: #66c783
        stroke: rgba(28, 121, 74, .25)
        stroke-width: 1.2
      .loading-earth-line
        fill: none
        stroke: rgba(255, 255, 255, .30)
        stroke-width: 1.4

    .loading-transmitter
      position: absolute
      right: 0
      top: 50%
      width: 10px
      height: 10px
      margin-top: -5px
      border-radius: 50%
      background: #46b6ff
      box-shadow: 0 0 0 4px rgba(70, 182, 255, .12), 0 0 18px rgba(70, 182, 255, .7)
      &:before,
      &:after
        content: ''
        position: absolute
        left: 50%
        top: 50%
        width: 18px
        height: 18px
        margin-left: -9px
        margin-top: -9px
        border: 1px solid rgba(70, 182, 255, .48)
        border-radius: 50%
        animation: loadingTransmitPulse 1.8s ease-out infinite
      &:after
        animation-delay: .9s

    .loading-connection
      position: relative
      flex: 1 1 auto
      min-width: 138px
      height: 70px
      margin: 0 5px
      z-index: 2

    .loading-beam
      position: absolute
      left: 0
      right: 0
      top: 50%
      height: 2px
      margin-top: -1px
      border-radius: 999px
      background: repeating-linear-gradient(90deg, rgba(70, 182, 255, .18) 0 7px, rgba(66, 90, 239, .58) 7px 14px, rgba(124, 108, 255, .18) 14px 21px)
      background-size: 42px 2px
      box-shadow: 0 0 10px rgba(66, 90, 239, .14)
      animation: loadingBeamFlow 1.05s linear infinite
      &:before
        content: ''
        position: absolute
        inset: -8px 0
        background: linear-gradient(90deg, transparent, rgba(70, 182, 255, .10), rgba(124, 108, 255, .11), transparent)
        filter: blur(5px)

    .loading-signal
      position: absolute
      top: 50%
      left: 0
      width: 8px
      height: 8px
      margin-top: -4px
      border-radius: 50%
      background: #fff
      border: 2px solid #46b6ff
      box-shadow: 0 0 12px rgba(70, 182, 255, .85)
      opacity: 0
      animation: loadingSignalFly 2.1s cubic-bezier(.36,.04,.3,1) infinite

    .loading-signal-2
      animation-delay: .52s
    .loading-signal-3
      animation-delay: 1.04s
    .loading-signal-4
      animation-delay: 1.56s

    .loading-packet
      position: absolute
      top: 12px
      left: 0
      color: rgba(66, 90, 239, .54)
      font-size: 8px
      font-family: Consolas, Monaco, monospace
      letter-spacing: .08em
      opacity: 0
      animation: loadingPacketFly 3.2s linear infinite

    .loading-packet-2
      top: auto
      bottom: 11px
      animation-delay: 1.6s
      color: rgba(70, 182, 255, .58)

    .loading-link-wave
      position: absolute
      right: -5px
      top: 50%
      width: 16px
      height: 16px
      margin-top: -8px
      border: 1px solid rgba(124, 108, 255, .5)
      border-radius: 50%
      opacity: 0
      animation: loadingReceiveWave 1.7s ease-out infinite

    .loading-link-wave-2
      animation-delay: .85s

    .loading-station
      width: 112px
      height: 92px
      animation: loadingStationFloat 2.8s ease-in-out infinite

    .loading-station-glow
      position: absolute
      width: 68px
      height: 42px
      border-radius: 50%
      background: rgba(124, 108, 255, .14)
      filter: blur(15px)
      animation: loadingGlowPulse 2s ease-in-out infinite reverse

    .loading-station-icon
      width: 112px
      height: 84px
      overflow: visible
      filter: drop-shadow(0 10px 18px rgba(55, 65, 120, .15))
      .loading-panel
        fill: #5268d9
        stroke: #344ab9
        stroke-width: 2
      .loading-panel-line
        fill: none
        stroke: rgba(255, 255, 255, .28)
        stroke-width: 1
      .loading-truss,
      .loading-antenna
        fill: none
        stroke: #77829a
        stroke-width: 4
        stroke-linecap: round
      .loading-module
        fill: #f5f7fb
        stroke: #9aa4ba
        stroke-width: 3
      .loading-module-small
        fill: #cfd5e2
        stroke: #929db4
        stroke-width: 2
      .loading-window
        fill: #46b6ff
        stroke: #2e80d8
        stroke-width: 2
      .loading-antenna-tip
        fill: #7c6cff

    .loading-receiver
      position: absolute
      left: 3px
      top: 50%
      width: 9px
      height: 9px
      margin-top: -4px
      border-radius: 50%
      background: #7c6cff
      box-shadow: 0 0 14px rgba(124, 108, 255, .65)
      animation: loadingReceiverBlink 1.05s ease-in-out infinite

    .loading-brand
      color: var(--anzhiyu-fontcolor)
      font-size: 21px
      line-height: 1.3
      font-weight: 700
      letter-spacing: .02em
      margin-bottom: 7px

    .loading-message
      color: var(--anzhiyu-secondtext)
      font-size: 13px
      line-height: 1.6
      margin-bottom: 13px

    .loading-status-row
      display: flex
      align-items: center
      gap: 7px
      min-width: 238px
      padding: 8px 11px
      border-radius: 12px
      background: rgba(66, 90, 239, .055)
      border: 1px solid rgba(66, 90, 239, .08)
      color: var(--anzhiyu-secondtext)
      font-family: Consolas, Monaco, monospace
      font-size: 9px
      letter-spacing: .08em

    .loading-status-dot
      width: 7px
      height: 7px
      border-radius: 50%
      background: #58d68d
      box-shadow: 0 0 9px rgba(88, 214, 141, .55)
      animation: loadingStatusBlink 1.15s ease-in-out infinite

    .loading-status-text
      color: var(--anzhiyu-fontcolor)
      font-weight: 700

    .loading-status-code
      margin-left: auto
      opacity: .62

    &.loaded
      .loading-bg
        opacity: 0
        visibility: hidden
        pointer-events: none
        z-index: -1000
      .loading-card
        transform: translateY(-4px) scale(.985)

  [data-theme='dark'] #loading-box
    .loading-card
      background: rgba(24, 26, 34, .79)
      border-color: rgba(255, 255, 255, .08)
      box-shadow: 0 20px 62px rgba(0, 0, 0, .27)

    .loading-earth-icon
      filter: drop-shadow(0 10px 20px rgba(70, 182, 255, .22))

    .loading-station-icon
      .loading-module
        fill: #dfe4ed
      .loading-module-small
        fill: #adb7c9

    .loading-status-row
      background: rgba(124, 108, 255, .07)
      border-color: rgba(255, 255, 255, .07)

  @media screen and (max-width: 520px)
    #loading-box
      .loading-card
        width: 92vw
        max-width: 330px
        padding: 27px 20px 23px
        border-radius: 24px

      .loading-orbit-scene
        height: 96px

      .loading-earth
        width: 74px
        height: 74px

      .loading-earth-icon
        width: 68px
        height: 68px

      .loading-connection
        min-width: 82px
        margin: 0 2px

      .loading-station
        width: 89px
        height: 74px

      .loading-station-icon
        width: 89px
        height: 68px

      .loading-brand
        font-size: 19px

      .loading-message
        font-size: 12px
        text-align: center

      .loading-status-row
        min-width: 0
        width: 100%
        max-width: 250px

      .loading-packet
        display: none

  @media (prefers-reduced-motion: reduce)
    #loading-box
      .loading-card,
      .loading-earth,
      .loading-earth-glow,
      .loading-transmitter:before,
      .loading-transmitter:after,
      .loading-beam,
      .loading-signal,
      .loading-packet,
      .loading-link-wave,
      .loading-station,
      .loading-station-glow,
      .loading-receiver,
      .loading-status-dot
        animation: none !important
      .loading-signal
        opacity: .7
        &:nth-of-type(n+3)
          display: none

  @keyframes showLoading
    0%
      opacity: 0
    100%
      opacity: 1

  @keyframes loadingCardIn
    0%
      opacity: 0
      transform: translateY(8px) scale(.985)
    100%
      opacity: 1
      transform: translateY(0) scale(1)

  @keyframes loadingEarthFloat
    0%, 100%
      transform: translateY(2px) rotate(-1deg)
    50%
      transform: translateY(-4px) rotate(1deg)

  @keyframes loadingStationFloat
    0%, 100%
      transform: translateY(-2px) rotate(.5deg)
    50%
      transform: translateY(4px) rotate(-.7deg)

  @keyframes loadingGlowPulse
    0%, 100%
      opacity: .55
      transform: scale(.92)
    50%
      opacity: 1
      transform: scale(1.08)

  @keyframes loadingTransmitPulse
    0%
      opacity: .7
      transform: scale(.35)
    100%
      opacity: 0
      transform: scale(2.35)

  @keyframes loadingBeamFlow
    0%
      background-position: 0 0
    100%
      background-position: 42px 0

  @keyframes loadingSignalFly
    0%
      left: 0
      opacity: 0
      transform: scale(.62)
    12%
      opacity: 1
    78%
      opacity: 1
    100%
      left: 100%
      opacity: 0
      transform: scale(1.05)

  @keyframes loadingPacketFly
    0%
      left: 3%
      opacity: 0
    12%
      opacity: .8
    82%
      opacity: .65
    100%
      left: 91%
      opacity: 0

  @keyframes loadingReceiveWave
    0%
      opacity: .65
      transform: scale(.35)
    100%
      opacity: 0
      transform: scale(2.1)

  @keyframes loadingReceiverBlink
    0%, 100%
      opacity: .5
      transform: scale(.82)
    50%
      opacity: 1
      transform: scale(1.15)

  @keyframes loadingStatusBlink
    0%, 100%
      opacity: .45
    50%
      opacity: 1
