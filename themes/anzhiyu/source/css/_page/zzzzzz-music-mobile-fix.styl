// Final mobile layout fixes for SmallJia Music.
// Keep this file last in _page/* so it can safely override earlier music skins/polish layers.

@media screen and (max-width: 768px)
  body[data-type="music"]
    overflow-x hidden
    .layout
      width 100%
      max-width 100%
      padding-left 8px
      padding-right 8px

  #anMusic-page
    width 100%
    max-width 100%
    overflow clip
    padding-bottom calc(154px + env(safe-area-inset-bottom))

  .sjm-shell,
  .sjm-main,
  .sjm-view,
  .sjm-now-grid,
  .sjm-topbar,
  .sjm-now-card,
  .sjm-lyrics-card,
  .sjm-section,
  .sjm-page-head,
  .sjm-track-list,
  .sjm-track-list-large
    min-width 0
    max-width 100%

  .sjm-shell
    width 100%
    gap 10px

  .sjm-sidebar
    width 100%
    min-width 0
    padding 10px 8px
    overflow hidden

  .sjm-brand
    padding 4px 5px 10px

  .sjm-nav
    width 100%
    max-width 100%
    gap 4px
    padding-bottom 2px
    overflow-x auto
    overflow-y hidden
    overscroll-behavior-x contain
    -webkit-overflow-scrolling touch

  .sjm-nav::-webkit-scrollbar
    display none

  .sjm-nav-item
    flex 0 0 auto
    width auto
    min-width max-content
    min-height 40px
    padding 0 10px

  .sjm-topbar
    width 100%
    margin-bottom 10px
    padding 12px
    gap 10px

  .sjm-topbar-copy
    width 100%

  .sjm-topbar-copy h1
    margin-top 2px
    font-size 19px
    line-height 1.3

  .sjm-search-form
    width 100%
    max-width 100%
    height 44px
    padding-left 12px

  .sjm-search-form input
    width 100%

  .sjm-search-form button
    min-width 52px
    padding 0 12px

  .sjm-now-grid
    gap 10px

  .sjm-now-card
    width 100%

  .sjm-now-copy
    min-width 0
    max-width 100%

  .sjm-now-copy h2
    max-width 100%
    overflow hidden
    text-overflow ellipsis

  .sjm-now-actions
    width 100%
    max-width 100%

  .sjm-lyrics-card
    width 100%
    min-height 250px
    padding 16px

  .sjm-lyrics
    height 190px
    padding 64px 3px

  .sjm-section
    margin-top 10px
    padding 12px

  .sjm-section-head
    margin-bottom 8px

  .sjm-page-head
    padding 16px

  .sjm-page-head h2
    font-size 21px

  .sjm-track-list-large
    width 100%
    padding 6px

  .sjm-track-row
    width 100%
    min-width 0
    grid-template-columns 44px minmax(0,1fr) 34px
    gap 8px
    padding 6px

  .sjm-track-row .sjm-track-copy
    min-width 0

  .sjm-playerbar
    left 8px
    right 8px
    bottom calc(6px + env(safe-area-inset-bottom))
    width auto
    max-width none
    transform none
    grid-template-columns 1fr
    grid-template-rows auto auto
    gap 6px
    padding 8px 10px 9px

  .sjm-player-track
    grid-column 1
    grid-row 1
    width 100%

  .sjm-player-track .sjm-player-meta
    min-width 0

  .sjm-player-center
    grid-column 1
    grid-row 2
    width 100%
    grid-template-columns auto minmax(0,1fr)
    gap 8px

  .sjm-player-controls
    flex 0 0 auto
    gap 5px

  .sjm-progress-row
    min-width 0
    grid-template-columns 34px minmax(0,1fr) 34px
    gap 5px
    margin-top 0

  .sjm-toast
    bottom calc(126px + env(safe-area-inset-bottom))

  .sjm-fullscreen
    min-height 100vh
    min-height 100dvh

  .sjm-fullscreen-inner
    max-width 100%
    min-height 100vh
    min-height 100dvh
    padding-bottom calc(24px + env(safe-area-inset-bottom))

@media screen and (max-width: 560px)
  .sjm-brand-copy span
    display none

  .sjm-brand
    padding-bottom 8px

  .sjm-nav-item
    min-height 38px
    padding 0 9px

  .sjm-nav-item > span:nth-child(2)
    font-size 12px

  .sjm-now-card
    grid-template-columns 92px minmax(0,1fr)
    column-gap 14px
    row-gap 14px
    padding 14px

  .sjm-now-card > .sjm-cover-wrap
    width 92px
    height 92px

  .sjm-now-copy h2
    margin 5px 0 4px
    font-size 20px
    line-height 1.2
    -webkit-line-clamp 2

  .sjm-now-copy #sjm-now-artist
    font-size 13px

  .sjm-now-actions
    grid-template-columns repeat(2,minmax(0,1fr))
    gap 7px
    padding 7px

  .sjm-now-actions .sjm-soft-button,
  .sjm-now-actions .sjm-soft-button:not(#sjm-current-favorite)
    display flex !important
    min-width 0
    min-height 38px
    padding 0 6px
    font-size 10px
    overflow hidden
    text-overflow ellipsis

  .sjm-card-head
    align-items flex-start

  .sjm-card-head .sjm-card-tip
    display none

  .sjm-page-head
    gap 8px

  .sjm-page-head p
    line-height 1.55

  .sjm-search-badge
    display none

  .sjm-player-track img
    width 38px
    height 38px

  .sjm-control
    width 32px
    height 32px

  .sjm-control-main
    width 40px
    height 40px

@media screen and (max-width: 430px)
  body[data-type="music"]
    .layout
      padding-left 6px
      padding-right 6px

  #anMusic-page
    padding-bottom calc(158px + env(safe-area-inset-bottom))

  .sjm-sidebar
    padding 8px 6px

  .sjm-brand
    display none

  .sjm-nav
    padding 1px 0 2px

  .sjm-nav-item
    min-height 36px
    padding 0 8px
    grid-template-columns 20px auto auto

  .sjm-nav-item .sjm-nav-icon
    font-size 15px

  .sjm-topbar
    padding 10px

  .sjm-topbar-copy .sjm-eyebrow
    display none

  .sjm-topbar-copy h1
    margin 0
    font-size 18px

  .sjm-search-form
    height 42px
    padding-left 10px

  .sjm-search-form .sjm-search-icon
    margin-right 6px
    font-size 16px

  .sjm-search-form button
    min-width 48px
    height 32px
    padding 0 10px

  .sjm-now-card
    grid-template-columns 1fr
    grid-template-areas "cover" "copy" "actions"
    justify-items center
    row-gap 12px
    padding 16px 12px 12px
    text-align center

  .sjm-now-card > .sjm-cover-wrap
    width 126px
    height 126px

  .sjm-now-copy
    width 100%
    padding-right 0

  .sjm-now-copy h2
    font-size 21px
    -webkit-line-clamp 2

  .sjm-now-copy #sjm-now-artist
    font-size 14px

  .sjm-preview-badge
    margin-left auto
    margin-right auto

  .sjm-now-actions
    width 100%

  .sjm-lyrics-card
    min-height 230px
    padding 14px

  .sjm-lyrics
    height 174px
    padding 58px 2px

  .sjm-section
    padding 10px

  .sjm-section-head h3
    font-size 16px

  .sjm-track-list-large
    padding 4px

  .sjm-track-row
    grid-template-columns 40px minmax(0,1fr) 32px
    gap 7px
    min-height 54px
    padding 5px

  .sjm-track-row .sjm-track-cover
    width 40px
    height 40px
    border-radius 10px

  .sjm-playerbar
    left 6px
    right 6px
    bottom calc(5px + env(safe-area-inset-bottom))
    padding 7px 8px 8px
    border-radius 16px

  .sjm-player-center
    grid-template-columns 114px minmax(0,1fr)
    gap 6px

  .sjm-player-controls
    gap 2px

  .sjm-progress-row
    grid-template-columns 31px minmax(0,1fr) 31px
    gap 4px

  .sjm-progress-row span
    font-size 8px

  .sjm-toast
    width calc(100vw - 20px)
    bottom calc(126px + env(safe-area-inset-bottom))

@media screen and (max-width: 340px)
  .sjm-nav-item
    padding 0 7px

  .sjm-nav-item > span:nth-child(2)
    font-size 11px

  .sjm-now-card > .sjm-cover-wrap
    width 112px
    height 112px

  .sjm-now-actions
    grid-template-columns 1fr 1fr

  .sjm-player-track img
    width 34px
    height 34px

  .sjm-player-center
    grid-template-columns 108px minmax(0,1fr)

  .sjm-control
    width 30px
    height 30px

  .sjm-control-main
    width 38px
    height 38px
