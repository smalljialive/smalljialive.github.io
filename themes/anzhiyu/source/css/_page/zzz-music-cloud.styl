.sjm-account-card
  display grid
  grid-template-columns 38px minmax(0,1fr)
  gap 10px
  align-items center
  margin 14px 0
  padding 12px
  border 1px solid rgba(66,90,239,.12)
  border-radius 16px
  background rgba(255,255,255,.82)
  box-shadow 0 8px 24px rgba(31,45,61,.06)

.sjm-account-icon
  width 38px
  height 38px
  border-radius 12px
  display flex
  align-items center
  justify-content center
  background rgba(66,90,239,.10)
  color #425aef
  font-size 18px

.sjm-account-copy
  min-width 0

.sjm-account-copy strong,
.sjm-account-copy span
  display block
  overflow hidden
  white-space nowrap
  text-overflow ellipsis

.sjm-account-copy strong
  color #263247
  font-size 13px

.sjm-account-copy span
  margin-top 2px
  color #7a869a
  font-size 11px

#sjm-account-action
  grid-column 1 / -1
  width 100%
  height 34px
  border 0
  border-radius 10px
  cursor pointer
  background #425aef
  color #fff
  font-weight 700
  transition .2s ease

#sjm-account-action:hover
  transform translateY(-1px)
  box-shadow 0 6px 16px rgba(66,90,239,.22)

.sjm-account-card[data-state="synced"] .sjm-account-icon
  background rgba(46,175,118,.12)
  color #2eaf76

.sjm-account-card[data-state="error"] .sjm-account-icon
  background rgba(225,90,90,.10)
  color #d84a4a

.sjm-auth-modal
  position fixed
  inset 0
  z-index 10050
  display flex
  align-items center
  justify-content center
  padding 22px

.sjm-auth-modal[hidden]
  display none !important

.sjm-auth-backdrop
  position absolute
  inset 0
  background rgba(22,29,44,.38)
  backdrop-filter blur(10px)

.sjm-auth-panel
  position relative
  z-index 1
  width 420px
  max-width 100%
  padding 28px
  border 1px solid rgba(66,90,239,.12)
  border-radius 24px
  background rgba(255,255,255,.97)
  box-shadow 0 24px 80px rgba(31,45,61,.22)

.sjm-auth-close
  position absolute
  top 14px
  right 16px
  width 34px
  height 34px
  border 0
  border-radius 50%
  cursor pointer
  background #f1f4f9
  color #5e6879
  font-size 22px
  line-height 1

.sjm-auth-panel h2
  margin 6px 0 8px
  color #263247
  font-size 26px

.sjm-auth-desc,
.sjm-auth-tip
  color #7a869a
  line-height 1.7

.sjm-auth-desc
  margin 0 0 18px
  font-size 13px

.sjm-auth-tip
  margin 14px 0 0
  font-size 11px

.sjm-auth-tabs
  display grid
  grid-template-columns 1fr 1fr
  gap 6px
  padding 4px
  margin-bottom 16px
  border-radius 12px
  background #f3f5f9

.sjm-auth-tabs button
  height 36px
  border 0
  border-radius 9px
  cursor pointer
  background transparent
  color #68758a
  font-weight 700

.sjm-auth-tabs button.active
  background #fff
  color #425aef
  box-shadow 0 2px 10px rgba(31,45,61,.08)

#sjm-auth-form label
  display block
  margin-top 13px
  color #536071
  font-size 12px
  font-weight 700

#sjm-auth-form input
  display block
  width 100%
  height 44px
  margin-top 7px
  padding 0 13px
  border 1px solid #dfe5ee
  border-radius 12px
  outline none
  background #fff
  color #263247
  box-sizing border-box
  transition .2s ease

#sjm-auth-form input:focus
  border-color rgba(66,90,239,.55)
  box-shadow 0 0 0 3px rgba(66,90,239,.08)

.sjm-auth-submit
  width 100%
  height 44px
  margin-top 18px
  border 0
  border-radius 12px
  cursor pointer
  background linear-gradient(135deg,#425aef,#6b5cff)
  color #fff
  font-weight 800

.sjm-auth-submit:disabled
  opacity .55
  cursor wait

.sjm-auth-message
  min-height 20px
  margin 12px 0 0
  color #6f7b8e
  font-size 12px

.sjm-auth-message.error
  color #d84a4a

.sjm-auth-message.success
  color #2eaf76

html.sjm-auth-open
  overflow hidden

@media screen and (max-width: 768px)
  .sjm-auth-modal
    padding 14px

  .sjm-auth-panel
    padding 24px 20px
    border-radius 20px

  .sjm-auth-panel h2
    font-size 22px
