body.sjm-fullscreen-open
  overflow hidden

.sjm-preview-badge
  display inline-flex
  align-items center
  width fit-content
  margin-top 8px
  padding 5px 10px
  border 1px solid rgba(245,158,11,.18)
  border-radius 999px
  background rgba(245,158,11,.09)
  color #b7791f
  font-size 11px
  font-weight 700

.sjm-preview-badge[hidden]
  display none !important

.sjm-fullscreen
  position fixed
  inset 0
  z-index 100000
  display none
  overflow hidden
  background linear-gradient(135deg,rgba(248,250,255,.98),rgba(241,245,253,.98))
  color #223047

.sjm-fullscreen.active
  display block

.sjm-fullscreen-bg
  position absolute
  inset -10%
  background-position center
  background-size cover
  opacity .12
  filter blur(70px) saturate(1.2)
  transform scale(1.08)
  pointer-events none

.sjm-fullscreen:before
  content ''
  position absolute
  inset 0
  background radial-gradient(circle at 18% 20%,rgba(66,90,239,.10),transparent 32%),radial-gradient(circle at 82% 70%,rgba(138,107,255,.08),transparent 34%),rgba(248,250,255,.72)
  pointer-events none

.sjm-fullscreen-close
  position absolute
  top 24px
  right 28px
  z-index 3
  width 44px
  height 44px
  border 1px solid rgba(68,85,126,.10)
  border-radius 50%
  background rgba(255,255,255,.78)
  box-shadow 0 10px 30px rgba(54,72,110,.10)
  color #5e6a7e
  font-size 28px
  line-height 1
  cursor pointer
  backdrop-filter blur(14px)
  transition .2s ease

.sjm-fullscreen-close:hover
  transform rotate(8deg) scale(1.04)
  color #2d3a52
  background #fff

.sjm-fullscreen-inner
  position relative
  z-index 2
  display grid
  grid-template-columns minmax(320px,42%) minmax(420px,58%)
  gap 64px
  width calc(100vw - 120px)
  max-width 1500px
  height 100vh
  margin 0 auto
  padding 54px 0 42px

.sjm-fullscreen-player
  display flex
  min-width 0
  flex-direction column
  align-items center
  justify-content center
  text-align center

.sjm-fullscreen-cover-wrap
  position relative
  display flex
  align-items center
  justify-content center
  width 58%
  max-width 420px
  min-width 240px
  aspect-ratio 1
  margin-bottom 30px

.sjm-fullscreen-cover-wrap:before
  content ''
  position absolute
  inset 13%
  z-index -1
  border-radius 50%
  background rgba(33,43,61,.16)
  box-shadow 0 34px 78px rgba(33,43,61,.25)
  filter blur(18px)

.sjm-fullscreen-vinyl
  position relative
  width 100%
  height 100%
  overflow hidden
  border-radius 50%
  background radial-gradient(circle at center,#181a20 0 7%,#050608 7.4% 18%,#17191f 18.4% 19%,#08090c 19.4% 38%,#15171c 38.4% 39%,#07080a 39.4% 58%,#13151a 58.4% 59%,#060709 59.4% 78%,#111318 78.4% 79%,#030405 79.4% 100%)
  box-shadow inset 0 0 0 1px rgba(255,255,255,.06),inset 0 0 46px rgba(255,255,255,.035),0 28px 70px rgba(35,47,74,.28)
  animation sjmVinylSpin 9s linear infinite
  animation-play-state paused
  will-change transform

.sjm-fullscreen-vinyl:before
  content ''
  position absolute
  inset 0
  z-index 1
  border-radius 50%
  background linear-gradient(128deg,transparent 8%,rgba(255,255,255,.12) 26%,transparent 42%,transparent 62%,rgba(255,255,255,.055) 77%,transparent 91%)
  pointer-events none

.sjm-fullscreen-vinyl.is-playing
  animation-play-state running

.sjm-fullscreen-vinyl-grooves
  position absolute
  inset 3%
  z-index 1
  border-radius 50%
  background repeating-radial-gradient(circle at center,rgba(255,255,255,.055) 0 1px,rgba(0,0,0,.05) 1px 3px,transparent 3px 6px)
  opacity .62
  pointer-events none

.sjm-fullscreen-cover-wrap img
  position absolute
  left 50%
  top 50%
  z-index 2
  display block
  width 56%
  height 56%
  object-fit cover
  border 7px solid rgba(10,11,14,.88)
  border-radius 50%
  box-shadow 0 0 0 2px rgba(255,255,255,.08),0 12px 34px rgba(0,0,0,.28)
  transform translate(-50%,-50%)

.sjm-fullscreen-vinyl-spindle
  position absolute
  left 50%
  top 50%
  z-index 3
  width 17px
  height 17px
  border 4px solid rgba(255,255,255,.74)
  border-radius 50%
  background #14161a
  box-shadow 0 0 0 2px rgba(0,0,0,.42),0 2px 9px rgba(0,0,0,.25)
  transform translate(-50%,-50%)
  pointer-events none

.sjm-fullscreen-meta
  display flex
  max-width 620px
  flex-direction column
  align-items center

.sjm-fullscreen-meta h2
  max-width 100%
  margin 8px 0 8px
  overflow hidden
  color #202b3d
  font-size clamp(28px,3vw,48px)
  font-weight 900
  line-height 1.15
  text-overflow ellipsis
  white-space nowrap

.sjm-fullscreen-meta p
  margin 2px 0
  color #657287

.sjm-fullscreen-meta #sjm-fullscreen-artist
  font-size 17px
  font-weight 700

.sjm-fullscreen-meta #sjm-fullscreen-album
  font-size 13px
  color #929baa

.sjm-fullscreen-controls
  display flex
  align-items center
  justify-content center
  gap 18px
  margin-top 26px

.sjm-fullscreen-controls button
  display flex
  align-items center
  justify-content center
  width 48px
  height 48px
  border 0
  border-radius 50%
  background rgba(255,255,255,.78)
  box-shadow 0 10px 28px rgba(52,70,109,.10)
  color #4f5e74
  cursor pointer
  transition .2s ease

.sjm-fullscreen-controls button:hover
  transform translateY(-2px)
  background #fff
  color #344bc9

.sjm-fullscreen-controls .sjm-fullscreen-play
  width 64px
  height 64px
  background #425aef
  box-shadow 0 14px 34px rgba(66,90,239,.26)
  color #fff
  font-size 20px

.sjm-fullscreen-controls .sjm-fullscreen-play:hover
  background #354ddc
  color #fff

.sjm-fullscreen-progress
  display grid
  grid-template-columns 48px 1fr 48px
  align-items center
  gap 12px
  width 78%
  max-width 520px
  margin-top 24px
  color #8691a2
  font-size 11px

.sjm-fullscreen-progress input
  width 100%

.sjm-fullscreen-volume-row
  display grid
  grid-template-columns 40px minmax(110px,1fr) 48px
  align-items center
  gap 10px
  width 66%
  max-width 430px
  margin-top 13px
  padding 7px 10px
  border 1px solid rgba(67,87,130,.08)
  border-radius 16px
  background rgba(255,255,255,.46)
  box-shadow 0 8px 24px rgba(52,70,109,.05)
  backdrop-filter blur(12px)

.sjm-fullscreen-mute
  display flex
  align-items center
  justify-content center
  width 34px
  height 34px
  padding 0
  border 0
  border-radius 10px
  background rgba(66,90,239,.07)
  color #53627a
  font-size 16px
  cursor pointer
  transition .18s ease

.sjm-fullscreen-mute:hover
  background rgba(66,90,239,.12)
  transform translateY(-1px)

#sjm-fullscreen-volume
  width 100%
  height 5px
  border 0
  border-radius 999px
  outline none
  appearance none
  -webkit-appearance none
  background rgba(67,87,130,.14)
  cursor pointer

#sjm-fullscreen-volume::-webkit-slider-thumb
  width 15px
  height 15px
  border 3px solid #fff
  border-radius 50%
  appearance none
  -webkit-appearance none
  background #425aef
  box-shadow 0 2px 8px rgba(66,90,239,.30)

#sjm-fullscreen-volume::-moz-range-thumb
  width 11px
  height 11px
  border 3px solid #fff
  border-radius 50%
  background #425aef
  box-shadow 0 2px 8px rgba(66,90,239,.30)

.sjm-fullscreen-volume-value
  color #69778d
  font-size 11px
  font-weight 800
  font-variant-numeric tabular-nums
  text-align right

.sjm-fullscreen-hint
  margin-top 10px !important
  color #a0a9b7 !important
  font-size 11px !important

.sjm-fullscreen-lyrics-panel
  display flex
  min-width 0
  min-height 0
  flex-direction column
  padding 38px 22px 22px 0

.sjm-fullscreen-lyrics-head
  display flex
  align-items flex-end
  justify-content space-between
  flex 0 0 auto
  padding 0 18px 18px
  border-bottom 1px solid rgba(69,88,132,.08)

.sjm-fullscreen-lyrics-head h3
  margin 4px 0 0
  color #202b3d
  font-size 24px

.sjm-fullscreen-lyrics-head > span
  color #98a2b2
  font-size 11px

.sjm-fullscreen-lyrics
  flex 1 1 auto
  min-height 0
  overflow-y auto
  padding 38vh 18px 38vh
  scroll-behavior smooth
  scrollbar-width none
  mask-image linear-gradient(to bottom,transparent 0,#000 15%,#000 85%,transparent 100%)

.sjm-fullscreen-lyrics::-webkit-scrollbar
  display none

.sjm-fullscreen-lyric-line
  display block
  width 100%
  margin 0
  padding 10px 0
  border 0
  background transparent
  color #a1aab7
  font-size clamp(18px,1.65vw,26px)
  font-weight 650
  line-height 1.45
  text-align left
  cursor pointer
  opacity .46
  transform-origin left center
  transition color .24s ease,opacity .24s ease,transform .24s ease,font-size .24s ease

.sjm-fullscreen-lyric-line.near
  color #69778c
  opacity .72

.sjm-fullscreen-lyric-line.active
  color #263247
  font-size clamp(25px,2.45vw,38px)
  font-weight 900
  opacity 1
  transform translateX(8px)

.sjm-fullscreen-lyrics .sjm-empty
  min-height 220px

@keyframes sjmVinylSpin
  from
    transform rotate(0deg)
  to
    transform rotate(360deg)

@media screen and (max-width: 980px)
  .sjm-fullscreen-inner
    grid-template-columns 1fr
    gap 8px
    width calc(100vw - 40px)
    padding 68px 0 24px
    overflow-y auto

  .sjm-fullscreen-player
    justify-content flex-start

  .sjm-fullscreen-cover-wrap
    width 210px
    min-width 210px
    margin-bottom 18px

  .sjm-fullscreen-meta h2
    font-size 28px

  .sjm-fullscreen-controls
    margin-top 18px

  .sjm-fullscreen-progress
    width 92%
    margin-top 18px

  .sjm-fullscreen-volume-row
    width 84%
    max-width 390px

  .sjm-fullscreen-lyrics-panel
    min-height 48vh
    padding 8px 0 0

  .sjm-fullscreen-lyrics-head
    padding 0 8px 12px

  .sjm-fullscreen-lyrics
    min-height 44vh
    padding 18vh 8px 18vh
    mask-image linear-gradient(to bottom,transparent 0,#000 10%,#000 90%,transparent 100%)

  .sjm-fullscreen-lyric-line,
  .sjm-fullscreen-lyric-line.active
    text-align center
    transform none

@media screen and (max-width: 520px)
  .sjm-fullscreen-close
    top 14px
    right 14px
    width 38px
    height 38px

  .sjm-fullscreen-inner
    width calc(100vw - 24px)
    padding-top 58px

  .sjm-fullscreen-cover-wrap
    width 170px
    min-width 170px

  .sjm-fullscreen-meta h2
    max-width 88vw
    font-size 24px

  .sjm-fullscreen-controls button
    width 44px
    height 44px

  .sjm-fullscreen-controls .sjm-fullscreen-play
    width 58px
    height 58px

  .sjm-fullscreen-progress
    grid-template-columns 42px 1fr 42px
    gap 8px

  .sjm-fullscreen-volume-row
    grid-template-columns 36px minmax(88px,1fr) 42px
    gap 7px
    width 92%
    padding 6px 8px

  .sjm-fullscreen-lyrics-head > span
    display none

@media (prefers-reduced-motion: reduce)
  .sjm-fullscreen-vinyl
    animation none !important
