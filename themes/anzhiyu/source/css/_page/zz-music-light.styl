// SmallJia Music light skin
// Keep the player architecture intact and only override the visual palette.

body[data-type="music"]
  background #f6f8fc
  color #263247
  #page-header #nav
    background rgba(255,255,255,.82) !important
    border-bottom 1px solid rgba(69,88,132,.10) !important
    box-shadow 0 8px 28px rgba(51,70,112,.06)
    #blog_name, .mask-name-container, #menus, #nav-right .nav-button, #nav-right #toggle-menu
      a, .back-home-button
        color #2c3850

html[data-theme="dark"] body[data-type="music"]
  background #f6f8fc
  color #263247
  #page-header #nav
    background rgba(255,255,255,.82) !important
    border-bottom 1px solid rgba(69,88,132,.10) !important
    #blog_name, .mask-name-container, #menus, #nav-right .nav-button, #nav-right #toggle-menu
      a, .back-home-button
        color #2c3850

#anMusic-page
  --sjm-card rgba(255,255,255,.86)
  --sjm-card-strong rgba(255,255,255,.96)
  --sjm-soft rgba(67,91,145,.055)
  --sjm-border rgba(62,83,130,.12)
  --sjm-muted #718096
  --sjm-faint #98a2b3
  color #263247

#sjm-music-bg
  filter blur(110px) saturate(110%)
  opacity .12

#anMusic-page:before
  background linear-gradient(135deg,rgba(249,251,255,.94),rgba(245,248,253,.90) 46%,rgba(250,251,255,.94)), radial-gradient(circle at 72% 18%,rgba(92,116,255,.10),transparent 34%)

.sjm-sidebar
  border-color var(--sjm-border)
  background rgba(255,255,255,.76)
  box-shadow 0 18px 55px rgba(56,75,118,.08)

.sjm-brand .sjm-brand-copy strong
  color #202b3d

.sjm-brand .sjm-brand-copy span
  color var(--sjm-muted)

.sjm-nav-item
  color #5f6b7e

.sjm-nav-item .sjm-nav-icon
  color #8994a6

.sjm-nav-item em
  background rgba(72,91,137,.07)
  color #7b8799

.sjm-nav-item:hover
  background rgba(74,98,160,.07)
  color #27344b

.sjm-nav-item.active
  background linear-gradient(135deg,rgba(66,90,239,.13),rgba(138,107,255,.08))
  color #2d43b8
  box-shadow inset 0 0 0 1px rgba(74,94,200,.08)

.sjm-nav-item.active .sjm-nav-icon,
.sjm-nav-item.active em
  color #425aef

.sjm-sidebar-note
  border-top-color rgba(69,88,132,.09)

.sjm-sidebar-note span
  color #9aa4b5

.sjm-sidebar-note p
  color #7d8899

.sjm-topbar
  border-color var(--sjm-border)
  background rgba(255,255,255,.84)
  box-shadow 0 16px 45px rgba(56,75,118,.07)

.sjm-topbar-copy h1
  color #202b3d

.sjm-eyebrow
  color #8792a5

.sjm-search-form
  border-color rgba(70,90,137,.12)
  background rgba(245,247,252,.92)

.sjm-search-form:focus-within
  border-color rgba(66,90,239,.45)
  background #fff
  box-shadow 0 0 0 3px rgba(66,90,239,.08)

.sjm-search-form .sjm-search-icon
  color #8994a6

.sjm-search-form input
  color #263247

.sjm-search-form input::placeholder
  color #a0a9b8

.sjm-source-chip
  border-color rgba(67,87,130,.10)
  background rgba(247,249,253,.92)
  color #728095

.sjm-now-card,
.sjm-lyrics-card,
.sjm-section,
.sjm-page-head
  border-color var(--sjm-border)
  background rgba(255,255,255,.86)
  box-shadow 0 16px 45px rgba(56,75,118,.08)

.sjm-cover-wrap img
  box-shadow 0 18px 38px rgba(56,75,118,.18)

.sjm-cover-wrap .sjm-cover-ring
  border-color rgba(74,94,140,.12)

.sjm-now-copy h2
  color #202b3d

.sjm-now-copy #sjm-now-artist
  color #4c5b72

.sjm-now-copy #sjm-now-album
  color var(--sjm-muted)

.sjm-soft-button
  border-color rgba(67,87,130,.10)
  background rgba(246,248,252,.95)
  color #66758b

.sjm-soft-button:hover,
.sjm-soft-button.active
  border-color rgba(66,90,239,.16)
  background rgba(66,90,239,.07)
  color #344bc9

.sjm-card-head h3,
.sjm-section-head h3,
.sjm-page-head h2
  color #202b3d

.sjm-card-head .sjm-card-tip
  color #9aa4b3

.sjm-lyric-line
  color #a5adba

.sjm-lyric-line.near
  color #68758a

.sjm-lyric-line.active
  color #263247

.sjm-empty
  color #9ba5b5

.sjm-empty .sjm-empty-icon
  color #a1aabd

.sjm-empty .sjm-empty-title
  color #536176

.sjm-text-button
  color #748197

.sjm-text-button:hover
  color #425aef

.sjm-page-head p
  color var(--sjm-muted)

.sjm-search-badge
  border-color rgba(67,87,130,.10)
  background #f6f8fc
  color #748197

.sjm-search-status
  color var(--sjm-muted)

.sjm-track-list-large
  border-color var(--sjm-border)
  background rgba(248,250,253,.72)

.sjm-track-row
  background rgba(249,250,253,.66)

.sjm-track-row:hover
  background #fff
  border-color rgba(70,91,139,.10)
  box-shadow 0 8px 22px rgba(58,76,117,.07)

.sjm-track-row.active
  background linear-gradient(135deg,rgba(66,90,239,.10),rgba(138,107,255,.055))
  border-color rgba(66,90,239,.17)

.sjm-track-row .sjm-track-cover
  background #eef2f7

.sjm-track-row .sjm-track-copy strong
  color #2a3548

.sjm-track-row .sjm-track-copy span
  color #7b8799

.sjm-track-row .sjm-track-source
  background rgba(72,91,137,.07)
  color #8a95a6

.sjm-track-row .sjm-track-favorite
  color #a2aaba

.sjm-track-row .sjm-track-favorite:hover,
.sjm-track-row .sjm-track-favorite.active
  background rgba(255,106,145,.08)
  color #f05f8c

.sjm-playerbar
  border-color rgba(67,87,130,.13)
  background rgba(255,255,255,.91)
  box-shadow 0 18px 55px rgba(53,70,109,.14)

.sjm-player-track .sjm-player-meta strong
  color #263247

.sjm-player-track .sjm-player-meta span
  color #7a8799

.sjm-control,
.sjm-control-small
  color #5f6d81

.sjm-control:hover,
.sjm-control-small:hover
  color #27344b
  background rgba(67,87,130,.07)

.sjm-control-main
  background #425aef
  color #fff
  box-shadow 0 9px 24px rgba(66,90,239,.24)

.sjm-control-main:hover
  background #354ddc
  color #fff

.sjm-control-small
  color #8792a5

.sjm-control-small.active
  color #425aef
  background rgba(66,90,239,.08)

.sjm-progress-row span
  color #98a2b2

#sjm-progress
  background rgba(67,87,130,.14)

#sjm-volume
  background rgba(67,87,130,.12)

#sjm-progress::-webkit-slider-thumb,
#sjm-volume::-webkit-slider-thumb
  background #425aef
  box-shadow 0 0 0 3px rgba(66,90,239,.09)

.sjm-player-extra
  color #7c899a

.sjm-toast
  border-color rgba(67,87,130,.13)
  background rgba(255,255,255,.96)
  color #435168
  box-shadow 0 14px 36px rgba(53,70,109,.14)

@media screen and (max-width:768px)
  body[data-type="music"]
    background #f6f8fc
  .sjm-sidebar,
  .sjm-topbar,
  .sjm-now-card,
  .sjm-lyrics-card,
  .sjm-section,
  .sjm-page-head,
  .sjm-playerbar
    background rgba(255,255,255,.92)
