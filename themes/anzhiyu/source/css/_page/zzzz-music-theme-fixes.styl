// SmallJia Music theme compatibility fixes
// Keep the dedicated music layout, but let the global theme switch actually affect it.

body[data-type="music"]
  #rightside
    display block !important

html[data-theme="dark"] body[data-type="music"]
  background #080b12
  color #fff
  #page-header #nav
    background rgba(8,11,18,.72) !important
    border-bottom 1px solid rgba(255,255,255,.06) !important
    box-shadow 0 8px 28px rgba(0,0,0,.20)
    #blog_name, .mask-name-container, #menus, #nav-right .nav-button, #nav-right #toggle-menu
      a, .back-home-button
        color #fff

html[data-theme="dark"] #anMusic-page
  --sjm-card rgba(14,19,31,.82)
  --sjm-card-strong rgba(17,23,38,.94)
  --sjm-soft rgba(255,255,255,.065)
  --sjm-border rgba(255,255,255,.10)
  --sjm-muted rgba(255,255,255,.58)
  --sjm-faint rgba(255,255,255,.36)
  color #fff

html[data-theme="dark"] #sjm-music-bg
  filter blur(90px) saturate(125%)
  opacity .42

html[data-theme="dark"] #anMusic-page:before
  background linear-gradient(135deg,rgba(5,8,15,.86),rgba(8,12,22,.78) 42%,rgba(10,14,25,.90)), radial-gradient(circle at 72% 18%,rgba(91,120,255,.16),transparent 34%)

html[data-theme="dark"] #anMusic-page .sjm-sidebar
  border-color var(--sjm-border)
  background rgba(8,12,21,.72)
  box-shadow 0 18px 60px rgba(0,0,0,.26)

html[data-theme="dark"] #anMusic-page .sjm-brand .sjm-brand-copy strong,
html[data-theme="dark"] #anMusic-page .sjm-topbar-copy h1,
html[data-theme="dark"] #anMusic-page .sjm-now-copy h2,
html[data-theme="dark"] #anMusic-page .sjm-card-head h3,
html[data-theme="dark"] #anMusic-page .sjm-section-head h3,
html[data-theme="dark"] #anMusic-page .sjm-page-head h2,
html[data-theme="dark"] #anMusic-page .sjm-empty .sjm-empty-title,
html[data-theme="dark"] #anMusic-page .sjm-track-row .sjm-track-copy strong,
html[data-theme="dark"] #anMusic-page .sjm-player-track .sjm-player-meta strong
  color #fff

html[data-theme="dark"] #anMusic-page .sjm-brand .sjm-brand-copy span,
html[data-theme="dark"] #anMusic-page .sjm-now-copy #sjm-now-album,
html[data-theme="dark"] #anMusic-page .sjm-page-head p,
html[data-theme="dark"] #anMusic-page .sjm-search-status
  color var(--sjm-muted)

html[data-theme="dark"] #anMusic-page .sjm-nav-item
  color rgba(255,255,255,.68)

html[data-theme="dark"] #anMusic-page .sjm-nav-item .sjm-nav-icon
  color rgba(255,255,255,.48)

html[data-theme="dark"] #anMusic-page .sjm-nav-item em
  background rgba(255,255,255,.07)
  color rgba(255,255,255,.50)

html[data-theme="dark"] #anMusic-page .sjm-nav-item:hover
  background rgba(255,255,255,.06)
  color #fff

html[data-theme="dark"] #anMusic-page .sjm-nav-item.active
  background linear-gradient(135deg,rgba(83,108,255,.28),rgba(139,107,255,.14))
  color #fff
  box-shadow inset 0 0 0 1px rgba(255,255,255,.06)

html[data-theme="dark"] #anMusic-page .sjm-nav-item.active .sjm-nav-icon,
html[data-theme="dark"] #anMusic-page .sjm-nav-item.active em
  color #fff

html[data-theme="dark"] #anMusic-page .sjm-sidebar-note
  border-top-color rgba(255,255,255,.07)

html[data-theme="dark"] #anMusic-page .sjm-sidebar-note span
  color rgba(255,255,255,.32)

html[data-theme="dark"] #anMusic-page .sjm-sidebar-note p
  color rgba(255,255,255,.43)

html[data-theme="dark"] #anMusic-page .sjm-topbar
  border-color var(--sjm-border)
  background rgba(12,17,29,.72)
  box-shadow 0 16px 45px rgba(0,0,0,.20)

html[data-theme="dark"] #anMusic-page .sjm-eyebrow
  color rgba(255,255,255,.38)

html[data-theme="dark"] #anMusic-page .sjm-search-form
  border-color rgba(255,255,255,.09)
  background rgba(255,255,255,.06)

html[data-theme="dark"] #anMusic-page .sjm-search-form:focus-within
  border-color rgba(107,126,255,.75)
  background rgba(255,255,255,.08)
  box-shadow 0 0 0 3px rgba(94,117,255,.12)

html[data-theme="dark"] #anMusic-page .sjm-search-form .sjm-search-icon
  color rgba(255,255,255,.48)

html[data-theme="dark"] #anMusic-page .sjm-search-form input
  color #fff

html[data-theme="dark"] #anMusic-page .sjm-search-form input::placeholder
  color rgba(255,255,255,.36)

html[data-theme="dark"] #anMusic-page .sjm-source-chip
  border-color rgba(255,255,255,.08)
  background rgba(255,255,255,.045)
  color rgba(255,255,255,.56)

html[data-theme="dark"] #anMusic-page .sjm-now-card,
html[data-theme="dark"] #anMusic-page .sjm-lyrics-card,
html[data-theme="dark"] #anMusic-page .sjm-section,
html[data-theme="dark"] #anMusic-page .sjm-page-head
  border-color var(--sjm-border)
  background var(--sjm-card)
  box-shadow 0 18px 60px rgba(0,0,0,.18)

html[data-theme="dark"] #anMusic-page .sjm-cover-wrap img
  box-shadow 0 20px 44px rgba(0,0,0,.32)

html[data-theme="dark"] #anMusic-page .sjm-cover-wrap .sjm-cover-ring
  border-color rgba(255,255,255,.12)

html[data-theme="dark"] #anMusic-page .sjm-now-copy #sjm-now-artist
  color rgba(255,255,255,.76)

html[data-theme="dark"] #anMusic-page .sjm-soft-button
  border-color rgba(255,255,255,.08)
  background rgba(255,255,255,.06)
  color rgba(255,255,255,.76)

html[data-theme="dark"] #anMusic-page .sjm-soft-button:hover,
html[data-theme="dark"] #anMusic-page .sjm-soft-button.active
  border-color rgba(255,255,255,.14)
  background rgba(255,255,255,.10)
  color #fff

html[data-theme="dark"] #anMusic-page .sjm-card-head .sjm-card-tip
  color var(--sjm-faint)

html[data-theme="dark"] #anMusic-page .sjm-lyric-line
  color rgba(255,255,255,.28)

html[data-theme="dark"] #anMusic-page .sjm-lyric-line.near
  color rgba(255,255,255,.55)

html[data-theme="dark"] #anMusic-page .sjm-lyric-line.active
  color #fff

html[data-theme="dark"] #anMusic-page .sjm-empty
  color var(--sjm-faint)

html[data-theme="dark"] #anMusic-page .sjm-empty .sjm-empty-icon
  color rgba(255,255,255,.32)

html[data-theme="dark"] #anMusic-page .sjm-text-button
  color rgba(255,255,255,.55)

html[data-theme="dark"] #anMusic-page .sjm-text-button:hover
  color #fff

html[data-theme="dark"] #anMusic-page .sjm-search-badge
  border-color rgba(255,255,255,.08)
  background rgba(255,255,255,.045)
  color rgba(255,255,255,.55)

html[data-theme="dark"] #anMusic-page .sjm-track-list-large
  border-color var(--sjm-border)
  background rgba(10,15,26,.50)

html[data-theme="dark"] #anMusic-page .sjm-track-row
  background rgba(255,255,255,.025)

html[data-theme="dark"] #anMusic-page .sjm-track-row:hover
  background rgba(255,255,255,.07)
  border-color rgba(255,255,255,.06)
  box-shadow none

html[data-theme="dark"] #anMusic-page .sjm-track-row.active
  background linear-gradient(135deg,rgba(78,104,255,.18),rgba(139,107,255,.09))
  border-color rgba(124,139,255,.26)

html[data-theme="dark"] #anMusic-page .sjm-track-row .sjm-track-cover
  background rgba(255,255,255,.06)

html[data-theme="dark"] #anMusic-page .sjm-track-row .sjm-track-copy span
  color var(--sjm-muted)

html[data-theme="dark"] #anMusic-page .sjm-track-row .sjm-track-source
  background rgba(255,255,255,.07)
  color rgba(255,255,255,.50)

html[data-theme="dark"] #anMusic-page .sjm-track-row .sjm-track-favorite
  color rgba(255,255,255,.42)

html[data-theme="dark"] #anMusic-page .sjm-track-row .sjm-track-favorite:hover,
html[data-theme="dark"] #anMusic-page .sjm-track-row .sjm-track-favorite.active
  background rgba(255,106,145,.10)
  color #ff7aa2

html[data-theme="dark"] #anMusic-page .sjm-playerbar
  border-color rgba(255,255,255,.10)
  background rgba(10,15,26,.92)
  box-shadow 0 18px 55px rgba(0,0,0,.28)

html[data-theme="dark"] #anMusic-page .sjm-player-track .sjm-player-meta span
  color var(--sjm-muted)

html[data-theme="dark"] #anMusic-page .sjm-control,
html[data-theme="dark"] #anMusic-page .sjm-control-small
  color rgba(255,255,255,.62)

html[data-theme="dark"] #anMusic-page .sjm-control:hover,
html[data-theme="dark"] #anMusic-page .sjm-control-small:hover
  color #fff
  background rgba(255,255,255,.07)

html[data-theme="dark"] #anMusic-page .sjm-control-small.active
  color #9aa7ff
  background rgba(90,112,255,.14)

html[data-theme="dark"] #anMusic-page .sjm-progress-row span
  color rgba(255,255,255,.42)

html[data-theme="dark"] #anMusic-page #sjm-progress,
html[data-theme="dark"] #anMusic-page #sjm-volume
  background rgba(255,255,255,.13)

html[data-theme="dark"] #anMusic-page .sjm-player-extra
  color rgba(255,255,255,.48)

html[data-theme="dark"] #anMusic-page .sjm-toast
  border-color rgba(255,255,255,.10)
  background rgba(14,19,31,.96)
  color rgba(255,255,255,.82)
  box-shadow 0 14px 36px rgba(0,0,0,.32)

@media screen and (max-width:768px)
  html[data-theme="dark"] body[data-type="music"]
    background #080b12
  html[data-theme="dark"] #anMusic-page .sjm-sidebar,
  html[data-theme="dark"] #anMusic-page .sjm-topbar,
  html[data-theme="dark"] #anMusic-page .sjm-now-card,
  html[data-theme="dark"] #anMusic-page .sjm-lyrics-card,
  html[data-theme="dark"] #anMusic-page .sjm-section,
  html[data-theme="dark"] #anMusic-page .sjm-page-head,
  html[data-theme="dark"] #anMusic-page .sjm-playerbar
    background rgba(10,15,26,.94)
